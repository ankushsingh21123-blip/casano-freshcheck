# FreshCheck backend configuration — PLACEHOLDER ONLY, no real key here.
# Same contents as the repo-root .env.example. Fill in your own key,
# obtained from tavily.com (free Researcher tier, no card required per
# Tavily docs). Do not commit this file with a real key — .env is gitignored.

TAVILY_API_KEY=

# Optional: comma-separated CORS origins. Default is localhost only.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: override the SQLite database path (used by tests).
# FRESHCHECK_DB_PATH=
