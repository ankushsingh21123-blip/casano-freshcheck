# FreshCheck backend configuration — PLACEHOLDER ONLY, no real key here.
# Copy this file to backend/.env and fill in your own key:
#   cp .env.example backend/.env
#
# Get a key from tavily.com (free Researcher tier, no card required per
# Tavily docs). Do not commit backend/.env — it is gitignored.

# Tavily API key. When unset, the backend runs in offline mode:
# no live search is performed and checks return verdict UNKNOWN
# with answer-only analysis.
TAVILY_API_KEY=

# Optional: comma-separated CORS origins. Default is localhost only:
# http://localhost:3000,http://127.0.0.1:3000
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: override the SQLite database path (used by tests).
# FRESHCHECK_DB_PATH=
